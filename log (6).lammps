reset_timestep 0

# ---- 2. self-folding at T ----
timestep    0.0005                         # 0.5 fs (H is light)
velocity    all create ${T} ${seed} mom yes rot yes dist gaussian
velocity    all create 300 ${seed} mom yes rot yes dist gaussian
velocity    all create 300 4928 mom yes rot yes dist gaussian
fix         nvt all nvt temp ${T} ${T} 0.05
fix         nvt all nvt temp 300 ${T} 0.05
fix         nvt all nvt temp 300 300 0.05
fix         mom all momentum 100 linear 1 1 1 angular   # no drift or spin

dump        d all custom 2000 origami.dump id type x y z c_peat
dump_modify d sort id
fix         eo all ave/time 100 10 1000 c_eA[1] c_eA[2] c_rg file energy.dat

run         ${nsteps}
run         160000
